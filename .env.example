# Copy to .env and fill in real values for local development.
# Never commit the real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM provider (server-side; used ONLY by the offline eval harness --
# end users bring their own key per provider, see LLM credentials below) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- Search provider ---
# "tavily" for real web search, "mock" to run fully offline (no API key needed)
SEARCH_PROVIDER=mock
TAVILY_API_KEY=

# --- Datastores (match infra/docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/research_agent
REDIS_URL=redis://localhost:6379/0

# --- Agent run limits (cost/runaway-loop protection) ---
AGENT_MAX_TOOL_STEPS=12
AGENT_MAX_REVISION_LOOPS=1
AGENT_MAX_TOKENS_PER_JOB=200000
AGENT_JOB_TIMEOUT_SECONDS=300

# --- API ---
API_KEY_RATE_LIMIT_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_MINUTE=10
DEV_SEED_API_KEY=dev-local-key
# JSON array -- only matters if a browser frontend calls the API directly
# from a different origin (e.g. `vite dev`). The Docker Compose frontend
# reverse-proxies /api instead, so this isn't needed for that deployment.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Auth: JWTs for the web app, bcrypt for passwords ---
# Generate a real value with: openssl rand -hex 32
# The committed default only works for local dev -- it's not a secret.
JWT_SECRET_KEY=insecure-dev-secret-change-me-in-any-shared-environment
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=10080

# --- Encrypts LlmCredential.encrypted_key (users' own provider API keys) at rest ---
# Generate a real value with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The committed default only works for local dev -- it's not a secret, and
# using it anywhere real users sign up means their provider keys are only
# as protected as this file is.
SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- File uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=10485760
